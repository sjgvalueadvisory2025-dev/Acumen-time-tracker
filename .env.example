# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Postgres connection string from Neon (free plan). Use the "pooled" connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random secret (at least 32 characters). Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# Comma-separated emails of administrators (they can create projects and see all reports).
ADMIN_EMAILS=you@example.com

# SMTP settings for sending sign-in codes. Gmail example (needs a Google "App password"):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=Time Tracker <you@gmail.com>

# Optional
APP_NAME=Acumen Time Tracker
# Timezone used for "today" and default report ranges (IANA name, e.g. Asia/Kolkata, America/New_York)
APP_TIMEZONE=UTC

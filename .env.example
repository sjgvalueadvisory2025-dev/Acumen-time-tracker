# Copy to .env.local for local development. On Vercel, DATABASE_URL is filled in
# automatically when you connect a Neon database from the Storage tab.

DATABASE_URL=postgresql://user:password@localhost:5432/timetracker

# Comma-separated emails of administrators (they can create projects and see all reports).
ADMIN_EMAILS=you@example.com

# Optional
APP_NAME=Acumen Time Tracker
# Timezone used for "today" and default report ranges (IANA name, e.g. Asia/Kolkata, America/New_York)
APP_TIMEZONE=UTC
